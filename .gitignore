# Python
__pycache__/
*.py[cod]
*.egg-info/

# Ausgaben (werden zur Laufzeit erzeugt)
out/final/*
out/dry-run/*
!out/final/.gitkeep
!out/dry-run/.gitkeep

# Persistenter State (pro User, nicht einchecken)
conf/*.state.json

# Beispiel-Auslagen nur als Vorlage; reale monatliche ODS nicht einchecken
# (conf/auslagen_*.ods wird nur als Beispiel gepflegt)
